{
  "name": "personauta",
  "description": "Espaces d'onglets façon Arc (perso/pro/loisir) avec épinglés et dossiers propres à chaque espace, fenêtre dédiée par espace, bascule via popup ou raccourcis clavier.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
